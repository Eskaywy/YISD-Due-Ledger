# ── Server ──────────────────────────────────────────────────────
# Port the Express server listens on (local dev only; Vercel sets its own)
PORT=3000

# JWT signing key — **CHANGE THIS IN PRODUCTION!**
JWT_SECRET=change-this-to-a-long-random-string-in-production

# CORS: the domain(s) your frontend is served from.
#   Local dev:  http://localhost:5173
#   Production: your Vercel domain (or custom domain)
CLIENT_URL="https://yisd.vercel.app/"

# Node environment (set to "production" for self-hosted deployments)
NODE_ENV=production

# ── Supabase ────────────────────────────────────────────────────
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL="https://your-project-ref.supabase.co"

# Service role key: Supabase Dashboard → Project Settings → API →
# service_role secret. Server-side only — NEVER expose this to the frontend
# or commit it. Locally, create a .env file (gitignored); in production, add
# these as Environment Variables in the Vercel dashboard.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ── Security / demo flags (LOCAL DEV ONLY) ─────────────────────
# Both flags are IGNORED when NODE_ENV=production, so a production
# deployment can never authenticate or seed a well-known demo credential.
# Enable them together for local preview/testing:
DEMO_MODE=false
SEED_DEMO_DATA=false

# ── Admin bootstrap (scripts/create-admin.js) ──────────────────
# The FIRST super_admin signs in with this dedicated username + password
# (email is optional and not used to log in). Used once for provisioning.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional contact email / display name stored on the admin record.
ADMIN_EMAIL=
ADMIN_NAME=

# ── OAuth / OIDC ───────────────────────────────────────────────
# OAuth2 authorization server is served at /oauth on this same port.
# The consent endpoint is: http://localhost:3000/oauth/consent
# Demo clients/users are in-memory and only active when DEMO_MODE=true
# (and NODE_ENV is not production).

# ── Demo OAuth accounts (LOCAL DEV ONLY, ignored in production) ──
# Leave unset to disable. Used only when DEMO_MODE=true and NODE_ENV != production.
DEMO_SUPERADMIN_EMAIL=
DEMO_SUPERADMIN_PASSWORD=
DEMO_SUPERADMIN_IDCODE=
DEMO_MEMBER_EMAIL=
DEMO_MEMBER_PASSWORD=
DEMO_MEMBER_IDCODE=

# ── Demo seed data (LOCAL DEV ONLY, ignored in production) ──────
# Used only when SEED_DEMO_DATA=true and NODE_ENV != production.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
SEED_MEMBER1_EMAIL=
SEED_MEMBER2_EMAIL=
SEED_MEMBER3_EMAIL=
SEED_MEMBER4_EMAIL=
SEED_MEMBER5_EMAIL=
